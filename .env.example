# Supabase > Project Settings > API (use a chave "anon / publishable", NUNCA a service_role)
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-publica

# Opcional: domínio próprio (ex.: https://hellobin.com). Se vazio, usa o domínio da Vercel.
NEXT_PUBLIC_SITE_URL=

# Opcional: código de verificação do Google Search Console (método "Tag HTML", só o valor de content)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
